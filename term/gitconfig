[user]
	name = Oscar Carlsson
	email = oscar@framer.com
[core]
    editor = vim
[color]
    branch = auto
    diff = auto
    status = auto
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[pull]
    default = current
[push]
	default = matching
[branch]
    autosetuprebase = always
[alias]
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    fl = log -u
    st = status
    cl = clone
    ci = commit -v
    co = checkout
    br = branch
    diff = diff --word-diff
    dc = diff --cached
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
